* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #171b2e;
  color: white;
  font-family: Arial, sans-serif;
}

.game-container {
  width: 90%;
  max-width: 850px;
  text-align: center;
}

h1 {
  color: #72e6ff;
  font-size: 42px;
  margin-bottom: 10px;
}

canvas {
  display: block;
  width: 100%;
  background: #dff7ff;
  border: 4px solid white;
  border-radius: 12px;
}

.controls {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 18px;
}

button {
  padding: 12px 24px;
  border: none;
  border-radius: 10px;
  background: #72e6ff;
  color: #171b2e;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #a4efff;
}

#message {
  font-size: 18px;
  font-weight: bold;
}
